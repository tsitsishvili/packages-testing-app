# elastic-audit stamps app.name/app.env onto every audit document as the
# service identity, and `elastic-audit:health` flags the framework default.
APP_NAME="Packages Testing App"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=app
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

DOCUMENTATOR_ENABLED=false
DOCUMENTATOR_CACHE=true
DOCUMENTATOR_TITLE="${APP_NAME} API"
DOCUMENTATOR_VERSION=1.2.0
DOCUMENTATOR_DESCRIPTION="Reference API for authentication, catalog, order, and audited integration flows."

HTTP_LOGS_ENABLED=true
HTTP_LOGS_QUEUE=default
HTTP_LOGS_SAMPLE_RATE=1.0
HTTP_LOGS_RETAIN_FOREVER=true

HTTP_LOGS_DASHBOARD_ENABLED=true
ELASTIC_AUDIT_DASHBOARD_PREFIX=logger
HTTP_LOGS_DASHBOARD_PATH=third-party

ACTIVITY_LOGS_ENABLED=true
ACTIVITY_LOGS_QUEUE=default
ACTIVITY_LOGS_RETAIN_FOREVER=true

LOG_ELASTICSEARCH_HOST=localhost
LOG_ELASTICSEARCH_PORT=9200
LOG_ELASTICSEARCH_SCHEME=http
LOG_ELASTICSEARCH_USERNAME=
LOG_ELASTICSEARCH_PASSWORD=
LOG_ELASTICSEARCH_INDEX_PREFIX=packages_testing_app
# Required by the two RETAIN_FOREVER flags above: ILM deletes whole indexes on
# its own schedule, so a delete phase would drop permanent documents with them.
LOG_ELASTICSEARCH_LIFECYCLE_DELETE_ENABLED=false

# --- Application performance monitoring (elastic-audit v5) -------------------
# Transactions/spans go to <prefix>_metrics, sampled PHP call stacks to
# <prefix>_profiles. Both are separate from the audit log subsystems above.
# Profiles additionally require ext-excimer (recommended) or modern ext-xhprof;
# with profiles enabled and neither installed, `elastic-audit:health` fails.
ELASTIC_AUDIT_METRICS_ENABLED=true
ELASTIC_AUDIT_METRICS_QUEUE=default
# Metrics have no retain-forever mode, so `elastic-audit:metrics:prune` (scheduled
# in routes/console.php) is what actually reclaims space here — ILM's delete phase
# is off cluster-wide for the permanent audit indexes.
ELASTIC_AUDIT_METRICS_RETENTION_DAYS=30

# Local test bed: capture everything at full rate so every span type is
# reproducible. Production should sample http/queries down well below 1.0.
ELASTIC_AUDIT_METRICS_HTTP_SAMPLE_RATE=1.0
ELASTIC_AUDIT_METRICS_QUERIES_SAMPLE_RATE=1.0

ELASTIC_AUDIT_PROFILES_ENABLED=true
ELASTIC_AUDIT_PROFILES_DRIVER=auto
# 1.0 only because this app exists to exercise the package; the package default
# of 0.01 is the right continuous-production value.
ELASTIC_AUDIT_PROFILES_SAMPLE_RATE=1.0
ELASTIC_AUDIT_PROFILES_QUEUE=default
ELASTIC_AUDIT_PROFILES_RETENTION_DAYS=7

ELASTIC_AUDIT_METRICS_DASHBOARD_ENABLED=true
ELASTIC_AUDIT_METRICS_DASHBOARD_PATH=metrics
